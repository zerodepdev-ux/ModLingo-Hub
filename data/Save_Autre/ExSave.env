# ============================================================
# CLES API — remplace Null par une valeur uniquement en local
# ============================================================
KeyOpenRouter=Null
KeyGemini=Null
KeyDeepL=Null

# ============================================================
# CONFIGURATION LM STUDIO
# ============================================================
LMStudioUrl=http://127.0.0.1:1234
LMStudioModel=Null
LMStudioEnabled=true
LMStudioParallel=4
LMStudioMaxTokens=2048
LMStudioContextTokens=4096
LMStudioMode=quality

# ============================================================
# CONFIGURATION GOOGLE RAPIDE
# ============================================================
GoogleFastEnabled=false
GoogleFastConcurrency=8
GoogleFastDelayMs=150
GoogleFastMaxRetries=4
GoogleFastMaxChars=80
GoogleFastMaxTokens=24

# ============================================================
# LIMITES API ET OPENROUTER
# ============================================================
OpenRouterModel=openrouter/free
OpenRouterMinIntervalMs=3000
OpenRouterMaxRetries=4
OpenRouterChunkMax=24
MaxApiCallsPerSecond=1

# ============================================================
# AUTRES OPTIONS
# ============================================================
TargetLanguage=fr
SourceLanguage=auto
CacheEnabled=true
CacheSaveDelayMs=3000
ProviderSplit=50/50
PrivacyMode=local-first

